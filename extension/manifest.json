{
  "manifest_version": 3,
  "name": "Masquer mon adresse e-mail",
  "description": "Crée des adresses iCloud Hide My Email en un clic, avec la session rclone du PC.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "scripting", "clipboardWrite", "notifications"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Masquer mon adresse e-mail",
    "default_popup": "popup/popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}
  },
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}
